# NEXUS OPS environment variables
# Copy this file to .env and fill in your values.

# LLM provider
GROQ_API_KEY=

# Execution mode
# local = use LocalStack
# real = use real AWS
EXECUTION_MODE=mock
DEPLOY_MODE=demo

# AWS / LocalStack credentials and region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_AMI_ID=
DEFAULT_AMI_ID=
DEFAULT_SUBNET=
DEFAULT_SECURITY_GROUP=

# Redis
REDIS_URL=redis://localhost:6379

# Frontend API target
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=

# Safety limits
MAX_INSTANCES_PER_USER=20
MAX_MONTHLY_BUDGET_USD=500
MAX_CONCURRENT_TASKS=10

# Auth
REQUIRE_AUTH=false
ADMIN_API_KEY=nexus-admin-key

# Queue & timeout
TASK_TIMEOUT_SECONDS=1800
