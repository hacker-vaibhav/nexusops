# Frontend environment variables
# Copy to frontend/.env for local Vite dev, or set the same values in Vercel project settings.

# Backend API base URL.
# Leave blank locally if you rely on the Vite proxy from frontend/vite.config.js.
VITE_API_URL=

# WebSocket base URL for live task updates.
# Set this when the backend is hosted on a different domain.
VITE_WS_URL=

# Local development proxy target used by Vite only.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional local API key for demo/testing.
VITE_API_KEY=demo-user

# Optional UI/runtime mode hint.
VITE_EXECUTION_MODE=mock
