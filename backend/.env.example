# Backend environment variables
# Copy to backend/.env for local development.

GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

EXECUTION_MODE=mock
DEPLOY_MODE=demo

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_AMI_ID=
DEFAULT_AMI_ID=
DEFAULT_SUBNET=
DEFAULT_SECURITY_GROUP=

REDIS_URL=redis://localhost:6379

REQUIRE_AUTH=false
ADMIN_API_KEY=nexus-admin-key

TASK_TIMEOUT_SECONDS=1800
MAX_INSTANCES_PER_USER=20
MAX_MONTHLY_BUDGET_USD=500
MAX_CONCURRENT_TASKS=10
